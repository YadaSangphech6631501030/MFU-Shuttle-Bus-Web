# Copy to .env.gps beside this file. Never commit the filled file.
GPS_ENABLED=true
GPS_BASE_URL=http://ww.ppgps171.com
GPS_USERNAME=""
GPS_PASSWORD=""
GPS_POLL_SECONDS=5
GPS_TIMEOUT_SECONDS=15
# Fresh GPS expires after 30 seconds; configure moving trackers to report frequently.
GPS_STALE_SECONDS=30
# Set kmh, mph or knots only after confirming the provider's speed unit.
GPS_SPEED_UNIT=unknown
