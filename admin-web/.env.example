VITE_API_BASE_URL=http://localhost:5101
# Required for every admin map page.
# Enable "Maps JavaScript API" in Google Cloud, enable billing, and allow this app URL in HTTP referrers.
# Local dev examples: http://localhost:5173/*, http://localhost:5174/*
VITE_GOOGLE_MAPS_API_KEY=

# Supabase Realtime Broadcast (read-only bus updates; API fallback if unavailable).
# Copy the Project URL and publishable key from Supabase. Never use a secret key here.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
