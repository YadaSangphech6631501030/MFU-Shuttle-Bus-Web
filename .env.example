DB_NAME=shuttlebus_web_system
SECRET_KEY=change_this_secret_before_real_deploy
CAMERA_URL=http://192.168.110.234:4747/video
SAVE_INTERVAL=5
INSTALL_DETECTOR=true

VITE_API_BASE_URL=http://localhost:5101
VITE_GOOGLE_MAPS_API_KEY=

USER_WEB_API_BASE_URL=http://localhost:5101

# Supabase Realtime Broadcast (MongoDB remains the database).
# Node publishes GPS snapshots to private mfu-buses / buses.updated.
# Run backend-node/sql/realtime.sql in Supabase before enabling browser subscriptions.
# Backend only. Never expose the secret key through a VITE_ variable.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME

# Browser configuration shared by passenger and admin builds.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME


# GPS credentials: copy backend-node/.env.gps.example to backend-node/.env.gps.
# The backend reads it locally; Docker mounts it read-only without baking it into images.
