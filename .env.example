# Copy this file to .env at the repository root (once for all services).
# Never commit .env. Only VITE_* values are exposed to browser code.

# Backend / MongoDB (Docker overrides PORT and MONGO_URI for its network).
PORT=5101
MONGO_URI=mongodb://localhost:27017/
DB_NAME=shuttlebus_web_system
SECRET_KEY=change_this_secret_before_real_deploy

# Detector. Camera URLs are configured per station in Admin Web.
# INSTALL_DETECTOR controls the Docker build and runtime.
SAVE_INTERVAL=5
INSTALL_DETECTOR=true
# Optional local overrides:
# DETECTOR_ENABLED=false
# PYTHON_BIN=python3

# GPS provider (backend only).
GPS_ENABLED=true
GPS_BASE_URL=http://ww.ppgps171.com
GPS_USERNAME=""
GPS_PASSWORD=""

GPS_POLL_SECONDS=5
GPS_TIMEOUT_SECONDS=15
# Fresh GPS expires after 30 seconds; configure trackers to report frequently.
GPS_STALE_SECONDS=30
# Set kmh, mph or knots only after confirming the provider's speed unit.
GPS_SPEED_UNIT=unknown

# Supabase Realtime Broadcast (MongoDB remains the database).
# Node publishes to private mfu-buses: buses.updated (GPS), public.updated (station crowds).
# Run backend-node/sql/realtime.sql in Supabase before enabling browser subscriptions.
# Backend only. Never expose the secret key through a VITE_ variable.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME

# Browser configuration shared by both web apps (local dev and Docker builds).
VITE_API_BASE_URL=http://localhost:5101
# Enable Maps JavaScript API and billing; allow each app URL in HTTP referrers.
VITE_GOOGLE_MAPS_API_KEY=
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
# Optional Docker-only passenger API override; otherwise uses VITE_API_BASE_URL.
# USER_WEB_API_BASE_URL=http://localhost:5101

# Optional admin seed settings; read by node backend-node/seed/seed_admin.js.
# ADMIN_USERNAME=admin
# ADMIN_EMAIL=admin@mfu.ac.th
# ADMIN_PASSWORD=replace_with_a_strong_password
